{
  "name": "miniweave",
  "version": "0.1.0",
  "private": true,
  "description": "A plugin-based coding agent harness, derived from MiniCode (MIT).",
  "type": "module",
  "bin": {
    "weave": "./bin/weave"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "node test/run-tests.mjs",
    "bench:tokens": "tsx bench/token-accuracy.ts",
    "bench:tokens:live": "tsx bench/token-accuracy.ts --live",
    "install-local": "tsx src/install.ts"
  },
  "dependencies": {
    "diff": "^8.0.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "^24.6.0",
    "eslint": "9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.46.4"
  },
  "optionalDependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4"
  }
}
